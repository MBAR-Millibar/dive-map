{
  "name": "@millibar/dive-map",
  "version": "1.4.1",
  "description": "The Millibar Dive Map: a world map highlighting the countries a diver has dived in, with Alpine and React adapters.",
  "keywords": [
    "diving",
    "scuba-diving",
    "world-map",
    "map",
    "jsvectormap",
    "alpinejs",
    "react"
  ],
  "homepage": "https://github.com/MBAR-Millibar/dive-map#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MBAR-Millibar/dive-map.git"
  },
  "bugs": {
    "url": "https://github.com/MBAR-Millibar/dive-map/issues"
  },
  "author": "Millibar <hello@millibar.io> (https://millibar.io)",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "src",
    "dive-map.css",
    "NOTICE"
  ],
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./alpine": "./src/alpine.js",
    "./react": "./src/react.js",
    "./countries": "./src/countries.js",
    "./dive-map.css": "./dive-map.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "regions": "node scripts/regions.mjs"
  },
  "dependencies": {
    "jsvectormap": "^1.7.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
